# ============================================================================
# Viens chop — configuration de l'API
# Copier en `.env` puis remplir. Ne JAMAIS committer le fichier .env.
# ============================================================================

# --- Neon -------------------------------------------------------------------
# Tableau de bord Neon → Connection Details → copier les deux chaînes :
#   DATABASE_URL        = la chaîne "Pooled connection" (contient -pooler)
#   DATABASE_URL_DIRECT = la chaîne "Direct connection" (migrations)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Secrets ----------------------------------------------------------------
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplace-moi-par-64-caracteres-aleatoires

# --- Jetons -----------------------------------------------------------------
JWT_TTL=15m
REFRESH_TTL_DAYS=30
# --- Inscription -------------------------------------------------------------
# Numéro + mot de passe : aucun code à envoyer, aucun fournisseur SMS.

# --- Administration ----------------------------------------------------------
# Mot de passe de la console admin.html. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Laisser vide = console fermée.
ADMIN_TOKEN=
ADMIN_TTL=8h

# --- Divers -----------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Origine du site statique (ou * en développement)
CORS_ORIGIN=*

# --- Paiement du Mode Debout ------------------------------------------------
# Rien à mettre pour le circuit manuel : le numéro Wave qui reçoit l'argent et
# le prix se règlent dans la console d'admin (onglet « Réglages »).
PAIEMENT_RATE_LIMIT_MAX=6
CHECKOUT_RATE_LIMIT_MAX=12

# --- Paiement automatique : Wave Business (facultatif) ----------------------
# Sans ces valeurs, l'application garde le circuit manuel (numéro + référence)
# et rien ne change à l'écran.
# Clé API : business.wave.com > Développeurs > Créer une clé API
#WAVE_API_KEY=wave_sn_prod_...
# Secret du webhook : business.wave.com > Webhooks (même page que l'URL)
#WAVE_WEBHOOK_SECRET=wave_sn_WHS_...
# Uniquement si tu as coché « signature de requête » sur la clé
#WAVE_SIGNING_SECRET=wave_sn_AKS_...
# Adresse du site, pour revenir dans l'application après le paiement
#SITE_URL=https://kaurel277-cmd.github.io/Viens-chop-
